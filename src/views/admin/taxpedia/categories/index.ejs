<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/admin/css/dashboard.css">
  <link rel="stylesheet" href="/admin/css/categories.css">
</head>
<body>
  <div class="app-shell">
    <%- include('../../../layouts/partials/admin-sidebar', { activePage }) %>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <main class="main-content">
      <header class="topbar">
        <button class="menu-toggle" id="menuToggle" aria-label="Open navigation">☰</button>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/admin">Dashboard</a><span>›</span><strong>Taxpedia Categories</strong>
        </nav>
        <div class="topbar-actions">
          <span class="today" id="today"></span>
          <span class="top-avatar">AD</span>
        </div>
      </header>

      <div class="dashboard-wrap categories-wrap">
        <section class="welcome-row categories-heading">
          <div>
            <p class="eyebrow">Taxpedia</p>
            <h1>Categories</h1>
            <p>Organize your tax knowledge base into clear top-level sections.</p>
          </div>
          <button class="primary-button borderless" id="createCategory"><span>＋</span> Add category</button>
        </section>

        <section class="category-summary" aria-label="Category summary">
          <article><span class="summary-icon violet">T</span><div><strong id="totalCount">0</strong><small>Total categories</small></div></article>
          <article><span class="summary-icon green">✓</span><div><strong id="activeCount">0</strong><small>Active categories</small></div></article>
          <article><span class="summary-icon amber">Ⅱ</span><div><strong id="inactiveCount">0</strong><small>Inactive categories</small></div></article>
        </section>

        <section class="panel categories-panel">
          <div class="category-toolbar">
            <div class="category-search"><span>⌕</span><input id="categorySearch" type="search" placeholder="Search categories..." aria-label="Search categories"></div>
            <select id="statusFilter" aria-label="Filter by status">
              <option value="all">All statuses</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>

          <div class="category-table-wrap">
            <table class="category-table">
              <thead><tr><th>Category</th><th>Slug</th><th>Order</th><th>Status</th><th>Updated</th><th><span class="sr-only">Actions</span></th></tr></thead>
              <tbody id="categoryList"></tbody>
            </table>
          </div>
          <div class="table-footer"><span id="resultCount">Showing 0 categories</span><span>Categories control the first level of Taxpedia navigation.</span></div>
        </section>
      </div>
    </main>
  </div>

  <div class="crud-modal" id="categoryModal" aria-hidden="true">
    <div class="modal-backdrop" data-close-modal></div>
    <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <header class="modal-header">
        <div><span class="modal-kicker">Taxpedia</span><h2 id="modalTitle">Add category</h2></div>
        <button type="button" class="modal-close" data-close-modal aria-label="Close">×</button>
      </header>
      <form id="categoryForm">
        <div class="form-error" id="formError" role="alert"></div>
        <div class="field full">
          <label for="categoryName">Category name <b>*</b></label>
          <input id="categoryName" name="name" maxlength="150" required placeholder="e.g. Direct Tax">
        </div>
        <div class="field full">
          <label for="categorySlug">Slug</label>
          <div class="input-prefix"><span>/taxpedia/</span><input id="categorySlug" name="slug" maxlength="180" placeholder="direct-tax"></div>
          <small>Generated automatically until you edit it.</small>
        </div>
        <div class="form-grid">
          <div class="field">
            <label for="categoryIcon">Icon</label>
            <input id="categoryIcon" name="icon" maxlength="500" placeholder="T or icon URL">
          </div>
          <div class="field">
            <label for="categoryColor">Color</label>
            <div class="color-field"><input id="categoryColor" name="color" type="color" value="#695bea"><span id="colorValue">#695bea</span></div>
          </div>
          <div class="field">
            <label for="displayOrder">Display order</label>
            <input id="displayOrder" name="display_order" type="number" min="0" value="0">
          </div>
          <div class="field">
            <label for="categoryStatus">Status</label>
            <select id="categoryStatus" name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select>
          </div>
        </div>
        <footer class="modal-actions">
          <button type="button" class="secondary-button" data-close-modal>Cancel</button>
          <button type="submit" class="primary-button borderless" id="saveCategory">Save category</button>
        </footer>
      </form>
    </section>
  </div>

  <div class="toast" id="toast" role="status"></div>
  <script src="/admin/js/dashboard.js" defer></script>
  <script src="/admin/js/categories.js" defer></script>
</body>
</html>
